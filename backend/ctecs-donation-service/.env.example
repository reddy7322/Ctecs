# ==============================================================================
# CTECS Trusted Donation Backend Configuration (SERVER-SIDE ONLY)
# NEVER ship these values inside the Android APK or commit a populated .env file.
# ==============================================================================

PORT=8443
NODE_ENV=production

# PostgreSQL connection string (parameterized queries only)
DATABASE_URL=postgres://ctecs_user:CHANGE_ME@127.0.0.1:5432/ctecs_donations

# Self-hosted mynkdev-21/upi-gateway server-side merchant credentials
# Obtain from your deployed upi-gateway Merchant Dashboard (test_key_/test_sec_ for sandbox)
UPI_GATEWAY_BASE_URL=https://upi-gateway.example.com
UPI_GATEWAY_API_KEY=REPLACE_WITH_MERCHANT_API_KEY
UPI_GATEWAY_API_SECRET=REPLACE_WITH_MERCHANT_API_SECRET
UPI_GATEWAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_HMAC_SECRET
UPI_GATEWAY_ACCOUNT_ID=

# Exact immutable CTECS donation recipient metadata
DONATION_RECIPIENT_UPI_ID=tvtelugu@ptyes
DONATION_RECIPIENT_NAME=madhu
DONATION_CURRENCY=INR
DONATION_DESCRIPTION=CTECS Coffee Support
DONATION_MIN_AMOUNT_INR=1
DONATION_MAX_AMOUNT_INR=50000

# Admin authentication (PBKDF2-HMAC-SHA256 salted hash + HMAC session signing key)
ADMIN_USER_ID=madhu_admin
ADMIN_PASSPHRASE_SALT=REPLACE_WITH_RANDOM_HEX_SALT
ADMIN_PASSPHRASE_HASH=REPLACE_WITH_PBKDF2_SHA256_HEX
ADMIN_TOKEN_SIGNING_SECRET=REPLACE_WITH_32_BYTE_RANDOM_HEX
